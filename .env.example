# Copy this file to .env for local backend development. Never commit .env.
# In Cloud Run, inject the sensitive values from Secret Manager instead.

# Server-side API credentials. Never expose these as VITE_* variables.
LTA_DATAMALL_ACCOUNT_KEY=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_API_TOKEN=

# Google Cloud and Firestore. Cloud Run uses its attached service account via
# Application Default Credentials; no service-account JSON key is required.
GCP_PROJECT_ID= qwiklabs-gcp-02-e3a0cea27f91
FIRESTORE_DATABASE_ID=(default)

# Application configuration
APP_URL=http://localhost:3000
PORT=8080
ENVIRONMENT=development
