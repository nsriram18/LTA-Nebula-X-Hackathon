# Copy this file to .env for local development. Never commit .env.
# Cloud Run receives sensitive values from Secret Manager.

# Backend-only credentials. Never expose these with a VITE_ prefix.
LTA_DATAMALL_ACCOUNT_KEY=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_API_TOKEN=

# Google Cloud and Firestore
GCP_PROJECT_ID=qwiklabs-gcp-02-e3a0cea27f91
FIRESTORE_DATABASE_ID=(default)

# Application configuration
APP_URL=http://localhost:3000
VITE_API_BASE_URL=
PORT=8080
ENVIRONMENT=development
SCHEDULER_SERVICE_ACCOUNT=lta-nebula@qwiklabs-gcp-02-e3a0cea27f91.iam.gserviceaccount.com
